        // inactive-color "gray"
        // urgent-color "blue"
        // active-gradient from="#12d563" to="#0b1824" angle=45
        // inactive-gradient from="#505050" to="#696969" angle=45 relative-to="workspace-view"
        // urgent-gradient from="#800" to="#a33" angle=45
    }
        }
        