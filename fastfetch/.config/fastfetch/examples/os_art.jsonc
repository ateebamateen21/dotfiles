// /home/ateebamateen/fastfetch_presets/examples/os_art.jsonc

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "modules": [
    "break",

    // ───────────────────── Hardware ─────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;5;218m┌────────────────────── Hardware ──────────────────────┐"
    },
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "38;5;218"
    },
    {
      "type": "cpu",
      "key": "├ CPU",
      "keyColor": "38;5;218"
    },
    {
      "type": "gpu",
      "key": "├ GPU",
      "keyColor": "38;5;218"
    },
    {
      "type": "memory",
      "key": "├ RAM",
      "keyColor": "38;5;218"
    },
    {
      "type": "disk",
      "key": "└ DISK",
      "keyColor": "38;5;218"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;218m└──────────────────────────────────────────────────────┘"
    },

    "break",

    // ───────────────────── Software ─────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;5;117m┌────────────────────── Software ──────────────────────┐"
    },
    {
      "type": "os",
      "key": "{icon} OS",
      "keyColor": "38;5;117"
    },
    {
      "type": "kernel",
      "key": "├ KERNEL",
      "keyColor": "38;5;117"
    },
    {
      "type": "packages",
      "key": "├ PKGS",
      "keyColor": "38;5;117"
    },
    {
      "type": "terminal",
      "key": "├ TERM",
      "keyColor": "38;5;117"
    },
    {
      "type": "shell",
      "key": "└ SHELL",
      "keyColor": "38;5;117"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;117m└──────────────────────────────────────────────────────┘"
    },

    "break",

    // ───────────────────── Misc ─────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;5;221m┌────────────────────── Misc ─────────────────────────┐"
    },
    {
      "type": "uptime",
      "key": "├ UPTIME",
      "keyColor": "38;5;221"
    },
    {
      "type": "datetime",
      "key": "├ TIME",
      "keyColor": "38;5;221",
      "format": "{14}:{18}:{20}"
    },
    {
      "type": "media",
      "key": "└ MEDIA",
      "keyColor": "38;5;221"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;221m└──────────────────────────────────────────────────────┘"
    },

    "break",

    { "type": "colors", "symbol": "circle" }
  ]
}
