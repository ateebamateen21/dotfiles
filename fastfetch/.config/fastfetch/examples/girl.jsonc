{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/fastfetch_presets/examples/girl_side_pose.png", 
    "type": "kitty", 
    "width": 25,
    "height": 18,
    "padding": {
      "top": 2,
      "right": 3
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;5;218m┌──────────────────────Hardware──────────────────────┐" 
    },
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "38;5;218"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "keyColor": "38;5;218"
    },
    {
      "type": "gpu",
      "key": "│ ├󰍛",
      "keyColor": "38;5;218"
    },
    {
      "type": "memory",
      "key": "│ ├󰍛",
      "keyColor": "38;5;218"
    },
    {
      "type": "disk",
      "key": "└ └",
      "keyColor": "38;5;218"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;218m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;5;117m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": "{icon} OS", 
      "keyColor": "38;5;117"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "38;5;117"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "38;5;117"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "38;5;117"
    },
    {
      "type": "shell",
      "key": "└ └",
      "keyColor": "38;5;117"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;117m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;5;221m┌───────────────────Miscellaneous────────────────────┐" 
    },
    {
      "type": "uptime",
      "key": " ┌",
      "keyColor": "38;5;221"
    },
    {
      "type": "datetime",
      "key": "│ ├",
      "keyColor": "38;5;221",
      "format": "{14}:{18}:{20}"
    },
    {
      "type": "media",
      "key": "│ ├",
      "keyColor": "38;5;221"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;221m└────────────────────────────────────────────────────┘"
    },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
