{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "#000000",
          "foreground": "#ff8c94",
          "style": "diamond",
          "leading_diamond": " <>  </>\ue0b2",
          "powerline_symbol": "\ue0b0",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "\ue0b0",
          "type": "git"
        },
        {
          "background": "#ff8c94",
          "foreground": "#000000",
          "options": {
            "fetch_version": true
          },
           "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "leading_diamond": "<transparent,#ff8c94>\ue0b0</>",
          "template": "<> </> {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "type": "node"
        },
        {
          "foreground": "#000000",
          "type": "npm",
          "background": "#81ff91",
          "template": "<> </> {{ .Full }}",
          "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "leading_diamond": "<transparent,#81ff91>\ue0b0</>"
        },
        {
  "type": "python",
  "style": "diamond",
  "background": "#ffd966",
  "foreground": "#000000",
  "leading_diamond": "<transparent,#ffd966>\ue0b0</>",
  "trailing_diamond": "\ue0b0",
  "options": {
    "fetch_version": true
  },
  "template": "<> </> {{ .Full }}"
}
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "#0c7bbb",
          "foreground": "#ffffff",
          "leading_diamond": "\u256d\u2500\ue0b2",
          "options": {
            "alpine": "\uf300",
            "arch": "\uf303",
            "centos": "\uf304",
            "debian": "\uf306",
            "elementary": "\uf309",
            "fedora": "\uf30a",
            "gentoo": "\uf30d",
            "linux": "\ue712",
            "macos": "\ue711",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "ubuntu": "\uf31c",
            "windows": "\ue70f"
          },
          "style": "diamond",
          "trailing_diamond": "\ue0b0",

          "template": " {{ if .WSL }}\ue712 on {{ end }}{{ .Icon }}  ",
          "type": "os"
        },

        {
          "background": "#8a62da",
          "foreground": "#ffffff",
          "leading_diamond": "<transparent,#8a62da>\ue0b0</>",
          "options": {
            "folder_icon": "\uf07b ",
            "folder_separator_icon": " \uf061 ",
            "home_icon": "\uf46d",
            "style": "agnoster_full"
          },
          "template": " \ue5ff {{ .Path }} ",
          "style": "diamond",
          "trailing_diamond": "",
          "type": "path"
        },
        {
          "type": "cpu",
          "style": "powerline",
          "background": "#ffb703",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "template": " CPU {{ .Percentage }}% "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "sysinfo",
          "style": "powerline",
          "foreground": "#81ff91",
          "template": "<#cc7eda> | </><#7eb8da> :</> {{ round .PhysicalPercentUsed .Precision }}%"
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "foreground": "#81ff91",
          "template": "<#cc7eda> | </><#7eb8da>💾 :</> {{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB"
        },
        {
          "background": "transparent",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#40c4ff{{end}}",
            "{{if eq \"Discharging\" .State.String}}#ff5722{{end}}",
            "{{if eq \"Full\" .State.String}}#4caf50{{end}}"
          ],
          "invert_powerline": true,
          "powerline_symbol": "\ue0b2",
          "options": {
            "charged_icon": "\ue22f ",
            "charging_icon": "\ueb2d ",
            "discharging_icon": "\uf244 "
          },
          "style": "powerline",
          "template": "<#cc7eda> | </><#7eb8da>⚡ : </>{{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 ",
          "type": "battery"
        },
        {
          "background": "#e47200",
          "foreground": "#4b4b4b",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "",
          "options": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",

          "template": "⌛ {{ .FormattedMs }} ",
          "type": "executiontime"
        },
        {
          "background": "#cecece",
          "foreground": "#4b4b4b",
          "leading_diamond": "\ue0b2",
          "options": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",
          "template": "⏰ {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b0",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
       {
          "foreground": "#0c7bbb",
          "foreground_templates": ["{{ if gt .Code 0 }}#ef5350{{ end }}"],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "\u2570\u2500\ue285  ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
